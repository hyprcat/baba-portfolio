---
/**
 * PivotDoodle.astro
 *
 * Hand-drawn metaphor for the About section: a curving arrow that bends
 * mid-flight, looping from up-right back down-left like a U-turn drawn with
 * a marker. A small tick mark and a few dots add hand-drawn texture. Reads
 * as "pivot from one path to another."
 */

interface Props {
  size?: number;
  float?: boolean;
  class?: string;
}

const { size = 160, float = false, class: className } = Astro.props;

const classes = [float ? 'doodle-float' : null, className]
  .filter(Boolean)
  .join(' ');
---

<svg
  aria-hidden="true"
  viewBox="0 0 200 200"
  width={size}
  class={classes || undefined}
  stroke="#111"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  fill="none"
>
  {/* Curving U-turn arrow. Starts low-left, climbs up-right, loops over,
      comes back down-left. Asymmetric loop, not a perfect arc. */}
  <path
    d="M28.4 142.7
       C 42.6 96.3, 88.7 58.4, 138.2 52.8
       C 168.9 49.6, 182.4 78.3, 162.7 102.6
       C 144.8 124.9, 108.3 128.4, 72.6 118.7"
  />
  {/* Arrowhead at the end, pointing down-left. Two short strokes. */}
  <path d="M82.3 109.6 L 72.6 118.7 L 81.4 128.9" />
  {/* Tick mark near the start of the path — "departure" indicator. */}
  <path d="M21.7 132.4 L 27.3 138.6" />
  {/* Two small dotted indicators tracing the bend. */}
  <circle cx="113.4" cy="61.8" r="1.4" fill="#111" stroke="none" />
  <circle cx="167.8" cy="83.2" r="1.4" fill="#111" stroke="none" />
  {/* One stray confidence stroke along the curve for hand-drawn texture. */}
  <path d="M58.6 121.3 C 71.4 108.7, 86.2 98.4, 102.7 92.6" />
</svg>
