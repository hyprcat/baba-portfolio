---
/**
 * FoodChairDoodle.astro
 *
 * Hand-drawn metaphor for the ESSEC Food Chair section. A chef's toque with
 * a fork resting beside it. Line art only, slight asymmetry, no fills
 * except the small accent dots. Decorative.
 */

interface Props {
  size?: number;
  float?: boolean;
  class?: string;
}

const { size = 160, float = false, class: className } = Astro.props;

const classes = [float ? 'doodle-float' : null, className]
  .filter(Boolean)
  .join(' ');
---

<svg
  aria-hidden="true"
  viewBox="0 0 200 168"
  width={size}
  class={classes || undefined}
  stroke="#111"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  fill="none"
>
  {/* Toque body. Three rounded lobes across the top, slightly off-symmetric. */}
  <path
    d="M42.8 78.6
       C 28.4 76.1, 21.7 58.4, 33.6 47.8
       C 31.9 32.7, 47.4 22.6, 60.3 31.7
       C 67.2 18.4, 91.6 17.9, 96.4 33.2
       C 112.7 24.3, 128.1 39.8, 122.4 53.6
       C 134.8 60.4, 131.6 79.2, 116.7 80.3
       L 42.8 78.6 Z"
  />
  {/* Hat band where the toque meets the head. */}
  <path d="M40.3 78.6 L 39.7 102.4 L 119.8 103.6 L 118.4 80.1" />
  {/* Two small stitch marks on the band for hand-drawn texture. */}
  <path d="M58.7 89.4 L 58.4 95.8" />
  <path d="M97.3 90.6 L 97.1 96.7" />
  {/* Fork resting to the right of the toque. Long handle, three tines. */}
  <path d="M158.6 32.7 L 162.3 138.4" />
  {/* Fork tines. Three short prongs at the top. */}
  <path d="M152.4 31.8 L 152.7 52.6" />
  <path d="M158.6 32.7 L 158.9 53.4" />
  <path d="M165.2 33.4 L 165.7 53.1" />
  {/* Tine yoke connecting them. */}
  <path d="M151.8 53.2 C 157.6 56.1, 165.4 56.3, 166.1 53.6" />
  {/* Tiny grip notch on the handle. */}
  <path d="M157.4 88.7 L 163.6 89.4" />
  {/* Small accent dot, a stray flour speck. */}
  <circle cx="78.4" cy="62.3" r="1.7" fill="#111" stroke="none" />
</svg>
