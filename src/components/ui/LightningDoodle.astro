---
/**
 * LightningDoodle.astro
 *
 * Hand-drawn lightning bolt for the closing CTA. Outline only (line drawing,
 * not a filled icon) plus a few short spark strokes for energy. Slight
 * asymmetry across every segment.
 */

interface Props {
  size?: number;
  float?: boolean;
  class?: string;
}

const { size = 160, float = false, class: className } = Astro.props;

const classes = [float ? 'doodle-float' : null, className]
  .filter(Boolean)
  .join(' ');
---

<svg
  aria-hidden="true"
  viewBox="0 0 120 168"
  width={size}
  class={classes || undefined}
  stroke="#111"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  fill="none"
>
  {/* Bolt outline. Closed zig-zag with intentionally uneven angles. */}
  <path
    d="M68.3 6.4
       L 21.7 78.6
       L 52.4 82.1
       L 38.9 156.3
       L 96.7 64.8
       L 64.2 61.3
       L 82.6 8.7
       Z"
  />
  {/* Spark lines around the bolt. Three short dashes at varied angles. */}
  <path d="M104.8 38.2 L 113.6 33.7" />
  <path d="M9.4 96.4 L 3.7 102.1" />
  <path d="M99.3 124.6 L 107.8 127.9" />
  {/* One tiny solid dot for accent energy. */}
  <circle cx="14.6" cy="46.3" r="1.8" fill="#111" stroke="none" />
</svg>
