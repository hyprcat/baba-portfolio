---
/**
 * CaseImpact.astro
 *
 * Case study 03. IMPACT Consulting, Hyderabad. The structural break
 * case: paragraph and quote, no giant numeral. One WorkshopDoodle on
 * desktop. Source copy in content/05-case-impact-brand-strategy.md.
 */

import WorkshopDoodle from '~/components/ui/WorkshopDoodle.astro';

interface Props {}
---

<section id="case-impact" class="section case">
  <div class="container-x case-container">
    <div class="case-doodle" aria-hidden="true">
      <WorkshopDoodle size={150} float={true} />
    </div>
    <p class="eyebrow case-eyebrow">case study 03 · sept 2023 to mar 2024 · project support intern</p>

    <h2 id="case-impact-h" class="h-section case-heading">
      The career pivot started here.
    </h2>

    <p class="case-meta">IMPACT Consulting, Hyderabad. Marketing and brand strategy. <span class="impact-stat">5 client BUs · 40% faster reporting</span></p>

    <div class="case-body">
      <div class="case-row">
        <svg class="case-glyph" aria-hidden="true" viewBox="0 0 32 32" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none">
          {/* Lightbulb — brand workshop idea moment */}
          <path d="M 10.4 13.6 C 10.4 8.6 12.7 5.4 16 5.4 C 19.4 5.4 21.7 8.6 21.6 13.6 C 21.6 16.3 20.4 18.4 18.6 19.7 L 18.4 22.4 L 13.6 22.6 L 13.4 19.7 C 11.6 18.4 10.4 16.3 10.4 13.6 Z" />
          <path d="M13.6 25.4 L 18.4 25.4" />
          <path d="M14.6 27.6 L 17.4 27.4" />
        </svg>
        <p>
          Six months at IMPACT, deliberately split between two tracks: client-facing brand work on five business units, and an internal tool for the consultancy&apos;s own recruitment funnel. The first time I sat in a positioning workshop, I watched the conversation move from "we sell biscuits" to "we sell the thing a parent feels good putting in a kid&apos;s lunchbox." That sentence is what the job actually is, and it is the part I came back from Hyderabad wanting to do for a career.
        </p>
      </div>
      <div class="case-row">
        <svg class="case-glyph" aria-hidden="true" viewBox="0 0 32 32" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none">
          {/* Clipboard — Power BI data tool */}
          <path d="M7.4 7.6 L 24.6 7.4 L 24.7 27.4 L 7.6 27.6 Z" />
          <path d="M12.6 5.4 L 19.4 5.6 L 19.4 9.6 L 12.6 9.4 Z" />
          <path d="M11.6 15.4 L 20.7 15.3" />
          <path d="M11.4 19.6 L 18.4 19.4" />
        </svg>
        <p>
          The internal tool I built in parallel collapsed a partner&apos;s half-day Monday review into a twenty-minute scan. That part was familiar territory. The brand work was the new thing, and it was what put me on the path to ESSEC.
        </p>
      </div>
    </div>

    <blockquote id="case-impact-quote" class="case-quote">
      Analytics tells you what people did last quarter. The brand workshop is where you decide what to do this one.
    </blockquote>

    <p class="case-tags">consumer positioning · campaign planning · client-facing · 5 client BUs · 6 months</p>
  </div>
</section>

<style>
  .case {
    border-top: 1px solid var(--ms-border-subtle);
  }

  .case-container {
    position: relative;
  }

  .case-doodle {
    display: none;
  }

  @media (min-width: 1024px) {
    .case-doodle {
      display: block;
      position: absolute;
      right: var(--space-7);
      top: var(--space-6);
    }
  }

  .case-eyebrow {
    margin-bottom: var(--space-3);
  }

  .case-heading {
    margin: 0 0 var(--space-4) 0;
    color: var(--ms-fg-1);
    max-width: 22ch;
  }

  .case-meta {
    margin: 0 0 var(--space-7) 0;
    font-size: 15px;
    color: var(--ms-fg-3);
    line-height: 1.6;
  }

  .impact-stat {
    display: inline-block;
    margin-left: var(--space-2);
    padding: 2px 10px;
    border: 1px solid var(--ms-border-default);
    border-radius: var(--r-pill);
    font-family: var(--ms-font-mono);
    font-size: 12px;
    color: var(--ms-fg-2);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .case-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 64ch;
    margin-bottom: var(--space-7);
    color: var(--ms-fg-2);
    font-size: 18px;
    line-height: 1.65;
  }

  .case-body p {
    margin: 0;
    flex: 1;
    min-width: 0;
  }

  .case-row {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .case-glyph {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    margin-top: 6px;
    color: var(--ms-fg-1);
  }

  @media (max-width: 480px) {
    .case-row {
      gap: var(--space-3);
    }
    .case-glyph {
      width: 28px;
      height: 28px;
    }
  }

  .case-quote {
    margin: 0 0 var(--space-7) 0;
    padding: var(--space-3) 0 var(--space-3) var(--space-5);
    border: 0;
    border-left: 2px solid var(--ms-accent);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.4;
    color: var(--ms-fg-1);
    max-width: 38ch;
    text-wrap: balance;
  }

  .case-tags {
    margin: 0;
    max-width: 64ch;
    font-family: var(--ms-font-mono);
    font-size: 11px;
    color: var(--ms-fg-3);
    letter-spacing: 0.04em;
    line-height: 1.7;
  }
</style>
