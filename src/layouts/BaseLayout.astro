---
/**
 * BaseLayout.astro
 *
 * The root document shell. Owns <html>, <head>, font loading, and the global
 * stylesheet pipeline. Pages or higher-level layouts (PageLayout) slot their
 * content into the body.
 *
 * Server-rendered, zero client-side JS, single light theme. No theme toggle,
 * no IntersectionObserver, no inline scripts.
 */

import SEOHead from '~/components/global/SEOHead.astro';
import '~/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  lang?: string;
  extraSchemas?: object[];
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex,
  lang = 'en',
  extraSchemas,
} = Astro.props;
---
<!DOCTYPE html><html lang={lang}>
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      extraSchemas={extraSchemas}
    />

    {/* Self-hosted woff2 fonts. @font-face declarations live in global.css.
        Two preloads:
        - Google Sans Flex latin: body + headline font, the dominant LCP font.
        - Fuzzy Bubbles latin: the .hl marker font. Without preload it loads
          *after* FCP, so when it swaps in it reshapes the .hl span inside the
          H1 and pushes the LCP element (.hero-sub) down — Lighthouse then
          re-anchors LCP to the post-swap paint, inflating element render
          delay by ~4.5s on throttled mobile. Loading it in parallel keeps
          the H1 stable through first paint.
        Other faces (latin-ext subsets, JetBrains Mono) stay swap-loaded. */}
    <link
      rel="preload"
      href="/fonts/google-sans-flex.latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/fuzzy-bubbles-400.latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="bg-canvas text-fg-1 antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
